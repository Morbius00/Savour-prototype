# SAVOR.AI Environment Variables
# Copy this file to .env.local and fill in your values

# =====================================================
# GOOGLE GEMINI API KEYS (multi-key failover support)
# =====================================================
# Add up to 5 Gemini API keys — they are tried in order.
# When one key hits its quota (429), the next is used automatically.
# Get free keys at: https://aistudio.google.com/app/apikey
# =====================================================

GEMINI_API_KEY_1=your_primary_gemini_api_key_here
GEMINI_API_KEY_2=your_second_gemini_api_key_here
GEMINI_API_KEY_3=your_third_gemini_api_key_here
GEMINI_API_KEY_4=your_fourth_gemini_api_key_here
GEMINI_API_KEY_5=your_fifth_gemini_api_key_here

# =====================================================
# APP CONFIG (optional)
# =====================================================
NEXT_PUBLIC_APP_NAME=SAVOR.AI
NEXT_PUBLIC_RESTAURANT_NAME=Chowman
